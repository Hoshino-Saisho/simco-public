/logo/b21bf95078dc13b8ce62925582e18c81355d934f.png",0,0,0],[39675555,"2026-08-18T15:57:24.433157+00:00","KINGMAKER",3015579,"哈哈哈",7,1,1,0,"https://d1fxy698ilbz6u.cloudfront.net/logo/b21bf95078dc13b8ce62925582e18c81355d934f.png",0,0,0],[39675603,"2026-08-18T16:00:25.094295+00:00","KINGMAKER",3015579,"https://www.simenergyempire.com/r/0Q1AQB/\n12点- 新时代\n进去后优先选择 GAS 和 SOLAR 发电",7,1,1,0,"https://d1fxy698ilbz6u.cloudfront.net/logo/b21bf95078dc13b8ce62925582e18c81355d934f.png",1,0,0]]}